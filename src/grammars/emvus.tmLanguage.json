{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "emvus",
  "scopeName": "source.emvus",
  "fileTypes": [
    "ev"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#modifiers"
    },
    {
      "include": "#control"
    },
    {
      "include": "#values"
    },
    {
      "include": "#types"
    },
    {
      "include": "#calls"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.block.emvus",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation",
              "begin": "\\$\\{",
              "end": "\\}"
            }
          ]
        },
        {
          "name": "string.quoted.single",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric",
          "match": "\\b(?:0x[0-9A-Fa-f_]+|\\d[\\d_]*(?:\\.\\d+)?)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "keyword.declaration",
          "match": "\\b(?:package|use|var|dynamic|enum|record|class|interface|exception|method|macro)\\b"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "storage.modifier",
          "match": "\\b(?:final|static|abstract|override|private|protected|public|scoped)\\b"
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "name": "keyword.control",
          "match": "\\b(?:if|else|while|for|in|switch|return|fail|success|break|continue|where)\\b"
        }
      ]
    },
    "values": {
      "patterns": [
        {
          "name": "constant.language",
          "match": "\\b(?:true|false|null|this|super|is|as|fiber|virtual|thread)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type",
          "match": "\\b(?:Int|String|Bool|Double|Void|Result|Option|List|Map|Dictionary|Tuple|integer|string|bool|double|array|map|tuple)\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "entity.name.function",
          "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*[(<])"
        }
      ]
    }
  }
}
