{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "emerald",
  "scopeName": "source.emerald",
  "fileTypes": [
    "ems"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#modifiers"
    },
    {
      "include": "#control"
    },
    {
      "include": "#values"
    },
    {
      "include": "#types"
    },
    {
      "include": "#calls"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.block.emvus",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation",
              "begin": "\\$\\{",
              "end": "\\}"
            }
          ]
        },
        {
          "name": "string.quoted.single",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric",
          "match": "\\b(?:0x[0-9A-Fa-f_]+|\\d[\\d_]*(?:\\.\\d+)?)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "keyword.declaration",
          "match": "\\b(?:namespace|use|class|interface|record|enum)\\b"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "storage.modifier",
          "match": "\\b(?:public|private|protected|static|final|abstract|owned|scoped|flow)\\b"
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "name": "keyword.control",
          "match": "\\b(?:if|else|while|for|return|switch|throw|try|catch|break|continue|match|defer|require)\\b"
        }
      ]
    },
    "values": {
      "patterns": [
        {
          "name": "constant.language",
          "match": "\\b(?:true|false|null|this|super|new)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type",
          "match": "\\b(?:Int|Long|Double|Float|Bool|String|Char|Byte|Void|Object)\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "entity.name.function",
          "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*[(<])"
        }
      ]
    }
  }
}
